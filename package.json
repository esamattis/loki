{
    "name": "loki",
    "type": "module",
    "packageManager": "pnpm@11.13.1",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:node": "vite build && vite build --config vite.node.config.ts",
        "build:binary": "$npm_execpath run build:node && node scripts/core/build-binary.mts",
        "release:binary": "node scripts/core/release-binary.mts",
        "start": "node dist-server/node.js",
        "preview": "$npm_execpath run build && vite preview",
        "deploy": "$npm_execpath run db:export:remote && $npm_execpath run build && wrangler deploy",
        "cf-typegen": "wrangler types --env-interface CloudflareBindings",
        "db:generate": "node scripts/core/db-generate.mts",
        "db:migrate": "node scripts/core/migrate-local.mts",
        "db:migrate:sqlite": "node scripts/migrate-sqlite.mts",
        "db:migrate:remote": "$npm_execpath run db:export:remote && drizzle-kit migrate --config drizzle.remote.config.ts",
        "db:export:remote": "mkdir -p backups && wrangler d1 export loki --remote --output \"backups/loki-$(date +%Y%m%d-%H%M%S).sql\"",
        "db:import:remote": "node scripts/core/import-remote.mts",
        "db:reset": "rm -rf .wrangler && $npm_execpath run db:migrate",
        "db:dev-user": "node scripts/insert-dev-user.mts",
        "db:dev-user:sqlite": "node scripts/insert-dev-user-sqlite.mts",
        "db:list-users": "node scripts/core/list-users.mts",
        "db:make-admin": "node scripts/core/make-admin.mts",
        "db:reset-password": "node scripts/core/reset-local-password.mts",
        "db:create-invitation": "node scripts/core/create-invitation.mts",
        "icons": "node scripts/generate-icons.mts",
        "test:e2e": "playwright test",
        "test:executable": "$npm_execpath run build:binary && playwright test --config playwright.executable.config.ts",
        "test:tsc": "tsc",
        "test:boundary": "node tests/core/core-boundary.ts && node scripts/core/check-core-boundary.mts",
        "prettier-write": "prettier --write .",
        "prettier-check": "prettier --check .",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "test": "$npm_execpath run test:tsc && node scripts/core/systemd-restart.mts --missing-ok && $npm_execpath run lint && $npm_execpath run prettier-write && $npm_execpath run prettier-check && $npm_execpath run test:boundary && $npm_execpath run test:e2e && $npm_execpath run test:executable"
    },
    "dependencies": {
        "@ai-sdk/openai": "^4.0.11",
        "@hono/node-server": "^2.0.8",
        "@tailwindcss/vite": "^4.3.2",
        "@types/node": "^26.1.1",
        "ai": "^7.0.22",
        "clsx": "^2.1.1",
        "cmd-ts": "^0.15.0",
        "dotenv": "^17.4.2",
        "drizzle-orm": "1.0.0-rc.4",
        "fast-xml-parser": "^5.10.0",
        "hono": "^4.12.34",
        "htmx.org": "^2.0.10",
        "tailwindcss": "^4.3.2",
        "zod": "^4.4.3",
        "zx": "^8.8.5"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.2.3",
        "@playwright/test": "^1.61.1",
        "drizzle-kit": "1.0.0-rc.4",
        "oxfmt": "^0.58.0",
        "oxlint": "^1.73.0",
        "prettier": "^3.9.4",
        "typescript": "^6.0.3",
        "vite": "^6.3.5",
        "vite-ssr-components": "^0.6.1",
        "wrangler": "^4.17.0"
    }
}
