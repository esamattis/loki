import { CoreUserOptionsSchema } from "../core/options.ts";

export const appConfig = {
    buildName: "Acorn Notes",
    defaultUserOptionsJson: JSON.stringify(CoreUserOptionsSchema.parse({})),
    executableName: process.platform === "win32" ? "acorn-notes.exe" : "acorn-notes",
    sqliteFilename: "acorn-notes.sqlite",
    storageDirectoryName(platform: NodeJS.Platform = process.platform): string {
        return platform === "win32" ? "Acorn Notes" : "acorn-notes";
    },
} as const;
