import type {
    AppRouterRenderProps,
    HonoRequestContext,
} from "@/core/create-app";
import { createAppRouter } from "@/core/create-app";
import { AppShell } from "@/core/app-shell";
import { CoreLayout } from "@/core/core-layout";
import { registerRoute } from "@/core/register-route";
import { registerCoreRoutes } from "@/core/register-routes";
import { AppPage } from "@/core/app-page";
import * as routes from "@/app/routes";

function PrivacyPolicyContent() {
    return (
        <>
            <h2>Acorn Notes privacy policy</h2>
            <p>Account data is stored only to provide this service.</p>
        </>
    );
}

function renderHome(c: HonoRequestContext) {
    return c.html(
        "<!doctype html><html><body><h1>Acorn Notes</h1><a href=\"/dashboard\">Open notes</a></body></html>",
    );
}

function renderDashboard(c: HonoRequestContext) {
    return c.render(
        <AppPage title="Notes">
            <p>Private Acorn workspace</p>
        </AppPage>,
    );
}

function renderApp(props: AppRouterRenderProps) {
    return (
        <AppShell>
            <CoreLayout
                authenticatedUserSubtitle={(user) =>
                    `${user.getDisplayName()}'s notes`
                }
                navigationLabel="Note actions"
                privacyPolicyContent={<PrivacyPolicyContent />}
            >
                {props.children}
            </CoreLayout>
        </AppShell>
    );
}

export const appRouter = createAppRouter({
    name: "Acorn Notes",
    title: "Acorn Notes",
    repositoryUrl: "https://example.test/acorn-notes",
    description: "A deliberately small note application.",
    basicAuthRealm: "Acorn Notes",
    authenticatedHome: routes.dashboard({}),
    logoPath: "/logo.svg",
    themeColor: "#166534",
    socialImagePath: "/logo.svg",
    socialImageAlt: "Acorn Notes",
    render: renderApp,
});

registerCoreRoutes(app);
registerRoute(app, "get", routes.home, renderHome);
registerRoute(app, "get", routes.dashboard, renderDashboard);
